# DragonNuke Server - Just Commands
# Run `just` to see all available commands

default:
    @just --list

# Development Commands

# Install dependencies
install:
    npm install

# Start the server in development mode
dev:
    npm run dev

# Start the server (requires root for remote wipe functionality)
start:
    @echo "⚠️  Starting server as current user. Remote wipe functionality requires root."
    node index.js

# Start the server as root (recommended for production)
start-root:
    sudo node index.js

# Configuration

# Create .env file from example
init-config:
    cp .env.example .env
    @echo "✅ Created .env file. Please edit it with your GCP settings."

# Validate configuration
check-config:
    @echo "🔍 Checking configuration..."
    @test -f .env || (echo "❌ .env file missing. Run 'just init-config'" && exit 1)
    @source .env && test "$$GOOGLE_CLOUD_PROJECT_ID" = "dragon-nuke" || (echo "❌ GOOGLE_CLOUD_PROJECT_ID should be 'dragon-nuke'" && exit 1)
    @source .env && test "$$GCP_BUCKET_NAME" = "dragon-nuke-bucket" || (echo "❌ GCP_BUCKET_NAME should be 'dragon-nuke-bucket'" && exit 1)
    @source .env && test -f "$$GOOGLE_APPLICATION_CREDENTIALS" || (echo "❌ Service account key file not found" && exit 1)
    @echo "✅ Configuration looks good!"

# GCP Management

# Test GCP connection
test-gcp:
    ./scripts/monitor.sh test-gcp

# Initialize GCP bucket with safe state
init-gcp:
    echo "safe" | gsutil cp - gs://dragon-nuke-bucket/nuke-trigger.txt

# Check GCP file content
check-gcp:
    gsutil cat gs://dragon-nuke-bucket/nuke-trigger.txt

# Trigger nuke (DANGEROUS - will actually nuke!)
trigger-nuke:
    ./scripts/trigger-nuke.sh

# Reset GCP trigger to safe state (emergency command)
emergency-safe:
    @echo "🛡️  Resetting GCP trigger to safe state"
    echo "safe" | gsutil cp - gs://dragon-nuke-bucket/nuke-trigger.txt

# Development & Testing

# Run in debug mode with verbose logging
debug:
    @echo "⚠️  Running debug mode as current user. Remote wipe functionality requires root."
    VERBOSE_LOGGING=true node index.js

# Run in debug mode as root
debug-root:
    sudo VERBOSE_LOGGING=true node index.js

# Update dependencies
update:
    npm update
    npm audit fix

# Clean up temporary files
clean:
    rm -rf node_modules/.cache
    rm -rf /tmp/dragon-nuke-*

# Quick Setup
setup: install init-config
    @echo "🚀 Dragon Nuke server setup complete!"
    @echo "Next steps:"
    @echo "1. Edit .env with your GCP settings"
    @echo "2. Run 'just start-root' to start the server"