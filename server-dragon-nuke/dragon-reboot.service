[Unit]
Description=DragonNuke Server - Remote block device wipe listener
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=10
User=root
ExecStart=/usr/bin/node /opt/dragon-nuke/server-dragon-nuke/index.js
WorkingDirectory=/opt/dragon-nuke/server-dragon-nuke
Environment=NODE_ENV=production
EnvironmentFile=/opt/dragon-nuke/server-dragon-nuke/.env

# Security settings
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dragon-nuke

[Install]
WantedBy=multi-user.target