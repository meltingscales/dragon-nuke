# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Dragon Nuke Testing Environment
#
# This Vagrantfile creates 8 VMs with complex mount scenarios to test
# the unmounting and filesystem nuking logic. Each VM has:
#
# Block Devices (will be nuked):
#   - /dev/sda: Main OS disk (~10GB)
#   - /dev/sdc: Additional 1GB data disk -> /mnt/data1
#   - /dev/sdd: Additional 2GB data disk -> /mnt/data2
#
# Complex Mount Scenarios (all on local disks, will be nuked):
#   - /mnt/data1: Primary data mount (ext4 on /dev/sdc)
#   - /mnt/data2: Secondary data mount (ext4 on /dev/sdd)
#   - /mnt/shared-bind: Bind mount from /mnt/data1/shared
#   - /mnt/backup-bind: Bind mount from /mnt/data2/backup
#   - /mnt/data1/nested: Nested bind mount of /mnt/data2
#   - /mnt/readonly-bind: Read-only bind mount
#   - /mnt/tmpfs-cache: tmpfs mount (memory-based)
#
# Safe Mounts (VirtualBox shared folders, will NOT be nuked):
#   - /vagrant/keys: Read-only mount of host ~/keys
#   - /vagrant/server-dragon-nuke-ro: Read-only mount of server code
#
# All VM data is copied to local disks so nuking won't affect host files.

Vagrant.configure("2") do |config|
  # Define 8 VMs
  (1..8).each do |i|
    config.vm.define "dragon-nuke-vm-#{i}" do |node|
      # Ubuntu 22.04 base box (jammy)
      node.vm.box = "ubuntu/jammy64"

      node.vm.hostname = "dragon-nuke-vm-#{i}"

      # VirtualBox provider settings
      node.vm.provider "virtualbox" do |vb|
        vb.name = "dragon-nuke-vm-#{i}"
        vb.memory = "1024"  # 1GB RAM
        vb.cpus = 1

        # Create 2 additional hard drives for testing unmount logic
        # Drive 1: 1GB disk for /mnt/data1
        disk1_path = "./disks/dragon-nuke-vm-#{i}-disk1.vdi"
        unless File.exist?(disk1_path)
          vb.customize ['createhd', '--filename', disk1_path, '--size', 1024]
        end
        vb.customize ['storageattach', :id, '--storagectl', 'SCSI', '--port', 2, '--device', 0, '--type', 'hdd', '--medium', disk1_path]

        # Drive 2: 2GB disk for /mnt/data2
        disk2_path = "./disks/dragon-nuke-vm-#{i}-disk2.vdi"
        unless File.exist?(disk2_path)
          vb.customize ['createhd', '--filename', disk2_path, '--size', 2048]
        end
        vb.customize ['storageattach', :id, '--storagectl', 'SCSI', '--port', 3, '--device', 0, '--type', 'hdd', '--medium', disk2_path]
      end

      # Mount dragon-nuke-key.json as read-only (on separate VirtualBox filesystem, not affected by nuke)
      node.vm.synced_folder File.expand_path("~/keys"),
                           "/vagrant/keys",
                           mount_options: ["ro"],
                           owner: "vagrant",
                           group: "vagrant"

      # Mount server-dragon-nuke directory as read-only (on separate VirtualBox filesystem, not affected by nuke)
      node.vm.synced_folder File.expand_path("../server-dragon-nuke"),
                           "/vagrant/server-dragon-nuke-ro",
                           mount_options: ["ro"],
                           owner: "vagrant",
                           group: "vagrant"

      # Mount provisioning scripts as read-only
      node.vm.synced_folder File.expand_path("./scripts"),
                           "/vagrant/scripts",
                           mount_options: ["ro"],
                           owner: "vagrant",
                           group: "vagrant"

      # Copy .env file (will be copied to local disk during provisioning)
      node.vm.provision "file", source: File.expand_path("../server-dragon-nuke/.env"),
                                destination: "/tmp/.env.ro"

      # Provisioning script
      node.vm.provision "shell", inline: <<-SHELL
        echo "Dragon VM #{i} provisioning..."

        # Fix any interrupted dpkg operations
        echo "Checking for interrupted dpkg operations..."
        export DEBIAN_FRONTEND=noninteractive
        dpkg --configure -a

        # Install dependencies
        echo "Installing dependencies..."
        apt-get update
        apt-get install -y curl rsync

        # Install Node.js if not present
        if ! command -v node &> /dev/null; then
          echo "Installing Node.js..."
          curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
          apt-get install -y nodejs
        fi

        # Install just if not present
        if ! command -v just &> /dev/null; then
          echo "Installing just..."
          curl --proto '=https' --tlsv1.2 -sSf https://just.systems/install.sh | bash -s -- --to /usr/local/bin
        fi

        # Setup additional hard drives
        bash /vagrant/scripts/setup-disks.sh

        # Create complex mount scenarios
        bash /vagrant/scripts/setup-mounts.sh

        # Populate drives with dummy data
        bash /vagrant/scripts/populate-data.sh

        # Display mount information
        echo ""
        echo "=== Mount Configuration ==="
        mount | grep -E '/mnt|/vagrant' | sort
        echo ""

        # Copy server code to writable location
        mkdir -p /home/vagrant/server-dragon-nuke
        rsync -av --exclude='node_modules' /vagrant/server-dragon-nuke-ro/ /home/vagrant/server-dragon-nuke/
        chown -R vagrant:vagrant /home/vagrant/server-dragon-nuke

        # Setup server as vagrant user
        cd /home/vagrant/server-dragon-nuke
        sudo -u vagrant npm install

        # Copy read-only .env file and fix the credentials path
        cp /tmp/.env.ro .env
        sed -i 's|GOOGLE_APPLICATION_CREDENTIALS=.*|GOOGLE_APPLICATION_CREDENTIALS=/vagrant/keys/dragon-nuke-key.json|' .env
        chown vagrant:vagrant .env
        chmod 444 .env

        # Kill any existing dragon-nuke processes
        if [ -f /var/run/dragon-nuke.pid ]; then
          OLD_PID=$(cat /var/run/dragon-nuke.pid)
          if ps -p $OLD_PID > /dev/null 2>&1; then
            echo "Killing old server process (PID: $OLD_PID)..."
            kill $OLD_PID
            sleep 2
          fi
        fi

        # Start server as root in background
        echo "Starting dragon-nuke server as root..."
        nohup node index.js > /var/log/dragon-nuke.log 2>&1 &
        echo $! > /var/run/dragon-nuke.pid

        # Health check - wait 5 seconds and verify server is running
        echo "Waiting 5 seconds for server to start..."
        sleep 5
        if ps -p $(cat /var/run/dragon-nuke.pid) > /dev/null 2>&1; then
          echo "✓ Server is running with PID: $(cat /var/run/dragon-nuke.pid)"
        else
          echo "✗ Server failed to start. Check logs:"
          tail -20 /var/log/dragon-nuke.log
          exit 1
        fi

        echo "Dragon VM #{i} provisioned successfully"
        echo "Keys mounted at: /vagrant/keys/"
        echo "Server code at: /home/vagrant/server-dragon-nuke/"
        ls -la /vagrant/keys/
      SHELL

      # Sanity check provisioner that runs always
      node.vm.provision "shell", run: "always", inline: <<-SHELL
        echo "Running sanity check..."
        sleep 5

        # Check if log file exists
        if [ ! -f /var/log/dragon-nuke.log ]; then
          echo "✗ SANITY CHECK FAILED: /var/log/dragon-nuke.log does not exist!"
          echo ""
          echo "=== Debug Information ==="
          echo "Process status:"
          if [ -f /var/run/dragon-nuke.pid ]; then
            PID=$(cat /var/run/dragon-nuke.pid)
            echo "PID file exists with value: $PID"
            if ps -p $PID > /dev/null 2>&1; then
              echo "Process $PID is running"
              ps aux | grep $PID | grep -v grep
            else
              echo "Process $PID is NOT running"
            fi
          else
            echo "PID file does not exist"
          fi
          echo ""
          echo "Server log (last 30 lines):"
          tail -30 /var/log/dragon-nuke.log
          echo ""
          echo "Available log files:"
          ls -la /var/log/dragon-*
          exit 1
        fi

        # Check if log file contains "Poll"
        if ! grep -q "Poll" /var/log/dragon-nuke.log; then
          echo "✗ SANITY CHECK FAILED: /var/log/dragon-nuke.log does not contain 'Poll'!"
          echo ""
          echo "=== Debug Information ==="
          echo "Log file contents:"
          cat /var/log/dragon-nuke.log
          echo ""
          echo "Server log (last 30 lines):"
          tail -30 /var/log/dragon-nuke.log
          echo ""
          echo "Process status:"
          if [ -f /var/run/dragon-nuke.pid ]; then
            PID=$(cat /var/run/dragon-nuke.pid)
            echo "PID: $PID"
            ps aux | grep $PID | grep -v grep
          fi
          exit 1
        fi

        echo "✓ Sanity check passed: /var/log/dragon-nuke.log exists and contains 'Poll'"
      SHELL
    end
  end
end
