# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Dragon Nuke Testing Environment
#
# This Vagrantfile creates 8 VMs across 4 different Linux distributions
# to test the unmounting and filesystem nuking logic across various platforms:
#   - 2x Ubuntu 22.04 (debian-based, apt)
#   - 2x RHEL 9 (rpm-based, dnf, enterprise)
#   - 2x Fedora 39 (rpm-based, dnf, bleeding edge)
#   - 2x Arch Linux (rolling release, pacman)
#
# Each VM has:
#
# Block Devices (will be nuked):
#   - /dev/sda: Main OS disk (~10GB)
#   - /dev/sdc: Additional 1GB data disk -> /mnt/data1
#   - /dev/sdd: Additional 2GB data disk -> /mnt/data2
#
# Complex Mount Scenarios (all on local disks, will be nuked):
#   - /mnt/data1: Primary data mount (ext4 on /dev/sdc)
#   - /mnt/data2: Secondary data mount (ext4 on /dev/sdd)
#   - /mnt/shared-bind: Bind mount from /mnt/data1/shared
#   - /mnt/backup-bind: Bind mount from /mnt/data2/backup
#   - /mnt/data1/nested: Nested bind mount of /mnt/data2
#   - /mnt/readonly-bind: Read-only bind mount
#   - /mnt/tmpfs-cache: tmpfs mount (memory-based)
#
# Safe Mounts (VirtualBox shared folders, will NOT be nuked):
#   - /vagrant/keys: Read-only mount of host ~/keys
#   - /vagrant/server-dragon-nuke-ro: Read-only mount of server code
#
# All VM data is copied to local disks so nuking won't affect host files.

Vagrant.configure("2") do |config|
  # Define VMs with different distributions to test cross-platform compatibility
  vms = [
    { id: 1, box: "ubuntu/jammy64",       name: "ubuntu-1",  distro: "ubuntu" },
    { id: 2, box: "ubuntu/jammy64",       name: "ubuntu-2",  distro: "ubuntu" },
    { id: 3, box: "generic/rhel9",        name: "rhel-1",    distro: "rhel" },
    { id: 4, box: "generic/rhel9",        name: "rhel-2",    distro: "rhel" },
    { id: 5, box: "bento/fedora-39",      name: "fedora-1",  distro: "fedora" },
    { id: 6, box: "bento/fedora-39",      name: "fedora-2",  distro: "fedora" },
    { id: 7, box: "generic/arch",         name: "arch-1",    distro: "arch" },
    { id: 8, box: "generic/arch",         name: "arch-2",    distro: "arch" },
  ]

  vms.each do |vm|
    config.vm.define "dragon-nuke-#{vm[:name]}" do |node|
      node.vm.box = vm[:box]
      node.vm.hostname = "dragon-nuke-#{vm[:name]}"

      # SSH configuration - fix authentication issues with generic boxes
      node.ssh.insert_key = true
      node.ssh.forward_agent = false
      node.ssh.keep_alive = true

      # Longer timeout for slower boxes
      node.vm.boot_timeout = 600

      # VirtualBox provider settings
      node.vm.provider "virtualbox" do |vb|
        vb.name = "dragon-nuke-#{vm[:name]}"
        vb.memory = "1024"  # 1GB RAM
        vb.cpus = 1

        # Graphics settings to prevent terminal flashing
        vb.gui = false  # Headless mode
        vb.customize ["modifyvm", :id, "--vram", "32"]  # 32MB VRAM (sufficient for headless)
        vb.customize ["modifyvm", :id, "--graphicscontroller", "vmsvga"]  # Better for Linux
        vb.customize ["modifyvm", :id, "--accelerate3d", "off"]

        # Create 2 additional hard drives for testing unmount logic
        # Different boxes use different storage controllers and port numbering
        storage_controller = case vm[:distro]
          when "ubuntu" then "SCSI"
          when "rhel", "fedora", "arch" then "SATA Controller"
          else "SATA Controller"
        end

        # Port numbers: Ubuntu uses ports 2,3 (0,1 occupied), others use ports 1,2 (0 occupied)
        port1, port2 = vm[:distro] == "ubuntu" ? [2, 3] : [1, 2]

        # Drive 1: 1GB disk for /mnt/data1
        disk1_path = "./disks/dragon-nuke-#{vm[:name]}-disk1.vdi"
        unless File.exist?(disk1_path)
          vb.customize ['createhd', '--filename', disk1_path, '--size', 1024]
        end
        vb.customize ['storageattach', :id, '--storagectl', storage_controller, '--port', port1, '--device', 0, '--type', 'hdd', '--medium', disk1_path]

        # Drive 2: 2GB disk for /mnt/data2
        disk2_path = "./disks/dragon-nuke-#{vm[:name]}-disk2.vdi"
        unless File.exist?(disk2_path)
          vb.customize ['createhd', '--filename', disk2_path, '--size', 2048]
        end
        vb.customize ['storageattach', :id, '--storagectl', storage_controller, '--port', port2, '--device', 0, '--type', 'hdd', '--medium', disk2_path]
      end

      # Mount dragon-nuke-key.json as read-only (on separate VirtualBox filesystem, not affected by nuke)
      node.vm.synced_folder File.expand_path("~/keys"),
                           "/vagrant/keys",
                           mount_options: ["ro"],
                           owner: "vagrant",
                           group: "vagrant"

      # Mount server-dragon-nuke directory as read-only (on separate VirtualBox filesystem, not affected by nuke)
      node.vm.synced_folder File.expand_path("../server-dragon-nuke"),
                           "/vagrant/server-dragon-nuke-ro",
                           mount_options: ["ro"],
                           owner: "vagrant",
                           group: "vagrant"

      # Mount provisioning scripts as read-only
      node.vm.synced_folder File.expand_path("./scripts"),
                           "/vagrant/scripts",
                           mount_options: ["ro"],
                           owner: "vagrant",
                           group: "vagrant"

      # Disable default /vagrant mount to prevent accidental modifications
      node.vm.synced_folder ".", "/vagrant", disabled: true

      # Mount vm-testing directory (with Vagrantfile and justfile) as read-only
      node.vm.synced_folder File.expand_path("."),
                           "/vagrant/vm-testing-ro",
                           mount_options: ["ro"],
                           owner: "vagrant",
                           group: "vagrant"

      # Copy .env file (will be copied to local disk during provisioning)
      node.vm.provision "file", source: File.expand_path("../server-dragon-nuke/.env"),
                                destination: "/tmp/.env.ro"

      # Provisioning script
      node.vm.provision "shell", inline: <<-SHELL
        echo "Dragon VM #{vm[:name]} (#{vm[:distro]}) provisioning..."

        # Distro-specific setup
        case "#{vm[:distro]}" in
          ubuntu)
            echo "Setting up Ubuntu..."
            export DEBIAN_FRONTEND=noninteractive
            dpkg --configure -a
            apt-get update
            apt-get install -y curl rsync

            # Install Node.js
            if ! command -v node &> /dev/null; then
              echo "Installing Node.js..."
              curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
              apt-get install -y nodejs
            fi
            ;;

          rhel)
            echo "Setting up RHEL..."
            # Disable SELinux temporarily for testing (prevents mount issues)
            setenforce 0 || true
            sed -i 's/^SELINUX=enforcing/SELINUX=permissive/' /etc/selinux/config

            dnf install -y curl rsync

            # Install Node.js via NodeSource (module streams are unreliable)
            if ! command -v node &> /dev/null; then
              echo "Installing Node.js..."
              curl -fsSL https://rpm.nodesource.com/setup_20.x | bash -
              dnf install -y nodejs
            fi
            ;;

          fedora)
            echo "Setting up Fedora..."
            dnf install -y curl rsync

            # Install Node.js
            if ! command -v node &> /dev/null; then
              echo "Installing Node.js..."
              curl -fsSL https://rpm.nodesource.com/setup_20.x | bash -
              dnf install -y nodejs
            fi
            ;;

          arch)
            echo "Setting up Arch Linux..."

            # Refresh mirrorlist to avoid 404 errors from stale box
            echo "Refreshing mirrorlist..."
            curl -s "https://archlinux.org/mirrorlist/?country=US&protocol=https&use_mirror_status=on" | sed -e 's/^#Server/Server/' -e '/^#/d' > /etc/pacman.d/mirrorlist.new
            if [ -s /etc/pacman.d/mirrorlist.new ]; then
              mv /etc/pacman.d/mirrorlist.new /etc/pacman.d/mirrorlist
            fi

            # Initialize and update keyrings first
            echo "Updating keyrings..."
            pacman-key --init
            pacman-key --populate archlinux

            # Add the missing key that's needed for package verification
            echo "Adding required PGP keys..."
            pacman-key --recv-keys F05E8C12131AEB5E --keyserver keyserver.ubuntu.com || echo "Warning: key import failed"
            pacman-key --lsign-key F05E8C12131AEB5E || echo "Warning: key signing failed"

            pacman -Sy --noconfirm archlinux-keyring || echo "Warning: keyring update failed"

            # Now try full system upgrade
            echo "Upgrading system packages..."
            pacman -Syu --noconfirm || {
              echo "Warning: Full upgrade failed, continuing with base system..."
              # Clear package cache and try to recover
              rm -rf /var/cache/pacman/pkg/*
              pacman -Sy --noconfirm
            }

            # Install required packages (Node.js and npm should already be in base box, just upgrade)
            echo "Installing/upgrading required packages..."
            pacman -S --noconfirm nodejs npm curl rsync || {
              echo "ERROR: Failed to install required packages"
              exit 1
            }
            ;;
        esac

        # Install just (cross-distro)
        if ! command -v just &> /dev/null; then
          echo "Installing just..."
          curl --proto '=https' --tlsv1.2 -sSf https://just.systems/install.sh | bash -s -- --to /usr/local/bin
        fi

        # Setup additional hard drives
        bash /vagrant/scripts/setup-disks.sh

        # Populate drives with dummy data BEFORE setting up complex mounts
        bash /vagrant/scripts/populate-data.sh

        # Create complex mount scenarios (includes read-only bind mount)
        bash /vagrant/scripts/setup-mounts.sh

        # Display mount information
        echo ""
        echo "=== Mount Configuration ==="
        mount | grep -E '/mnt|/vagrant' | sort
        echo ""

        # Copy server code to writable location
        mkdir -p /home/vagrant/server-dragon-nuke
        rsync -av --exclude='node_modules' /vagrant/server-dragon-nuke-ro/ /home/vagrant/server-dragon-nuke/
        chown -R vagrant:vagrant /home/vagrant/server-dragon-nuke

        # Setup server as vagrant user
        cd /home/vagrant/server-dragon-nuke
        sudo -u vagrant npm install

        # Copy read-only .env file and fix the credentials path
        cp /tmp/.env.ro .env
        sed -i 's|GOOGLE_APPLICATION_CREDENTIALS=.*|GOOGLE_APPLICATION_CREDENTIALS=/vagrant/keys/dragon-nuke-key.json|' .env
        chown vagrant:vagrant .env
        chmod 444 .env

        # Install systemd service
        echo "Installing dragon-nuke systemd service..."
        cp /vagrant/scripts/dragon-nuke-vm.service /etc/systemd/system/dragon-nuke.service
        systemctl daemon-reload

        # Stop existing service if running
        if systemctl is-active --quiet dragon-nuke; then
          echo "Stopping existing dragon-nuke service..."
          systemctl stop dragon-nuke
        fi

        # Enable and start the service
        systemctl enable dragon-nuke
        systemctl start dragon-nuke

        # Health check - wait 5 seconds and verify service is running
        echo "Waiting 5 seconds for service to start..."
        sleep 5
        if systemctl is-active --quiet dragon-nuke; then
          echo "✓ dragon-nuke service is running"
          systemctl status dragon-nuke --no-pager | head -10
        else
          echo "✗ dragon-nuke service failed to start. Check logs:"
          journalctl -u dragon-nuke -n 50 --no-pager
          systemctl status dragon-nuke --no-pager
          exit 1
        fi

        echo "Dragon VM #{vm[:name]} (#{vm[:distro]}) provisioned successfully"
        echo "Keys mounted at: /vagrant/keys/"
        echo "Server code at: /home/vagrant/server-dragon-nuke/"
        ls -la /vagrant/keys/
      SHELL

      # Sanity check provisioner that runs always
      node.vm.provision "shell", run: "always", inline: <<-SHELL
        echo "Running sanity check..."
        sleep 5

        # Check if systemd service is running
        if ! systemctl is-active --quiet dragon-nuke; then
          echo "✗ SANITY CHECK FAILED: dragon-nuke service is not running!"
          echo ""
          echo "=== Debug Information ==="
          echo "Service status:"
          systemctl status dragon-nuke --no-pager
          echo ""
          echo "Recent logs:"
          journalctl -u dragon-nuke -n 50 --no-pager
          exit 1
        fi

        # Check process is running with correct arguments
        echo "Checking process details..."
        PROCESS_CHECK=$(ps aux | grep 'node.*index.js' | grep -v grep)
        if [ -z "$PROCESS_CHECK" ]; then
          echo "✗ SANITY CHECK FAILED: node process not found!"
          echo ""
          echo "=== Process List ==="
          ps aux | grep node
          exit 1
        fi

        # Display process info
        echo "✓ Process running:"
        echo "$PROCESS_CHECK"

        # Verify process args
        PID=$(echo "$PROCESS_CHECK" | awk '{print $2}')
        echo ""
        echo "Process command line (PID $PID):"
        cat /proc/$PID/cmdline | tr '\\0' ' '
        echo ""

        # Check working directory
        echo "Working directory:"
        readlink -f /proc/$PID/cwd
        echo ""

        # Check if log file exists
        if [ ! -f /var/log/dragon-nuke.log ]; then
          echo "✗ SANITY CHECK FAILED: /var/log/dragon-nuke.log does not exist!"
          echo ""
          echo "=== Debug Information ==="
          journalctl -u dragon-nuke -n 50 --no-pager
          exit 1
        fi

        # Check if log file contains "Poll"
        if ! grep -q "Poll" /var/log/dragon-nuke.log; then
          echo "✗ SANITY CHECK FAILED: /var/log/dragon-nuke.log does not contain 'Poll'!"
          echo ""
          echo "=== Debug Information ==="
          echo "Log file contents (last 50 lines):"
          tail -50 /var/log/dragon-nuke.log
          echo ""
          echo "Journalctl logs:"
          journalctl -u dragon-nuke -n 50 --no-pager
          exit 1
        fi

        echo ""
        echo "✓ All sanity checks passed!"
        echo "  - Service is active"
        echo "  - Process running with correct args"
        echo "  - Log file exists and contains 'Poll'"
      SHELL
    end
  end
end
