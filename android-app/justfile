# Dragon Nuke Android App - Just Commands

default:
    @just --list

# Install Android SDK command-line tools (run this first if SDK not installed)
install-sdk:
    @echo "📦 Installing Android SDK command-line tools..."
    mkdir -p ~/Android/Sdk
    cd ~/Android/Sdk && wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip
    cd ~/Android/Sdk && unzip -q commandlinetools-linux-11076708_latest.zip
    mkdir -p ~/Android/Sdk/cmdline-tools/latest
    cd ~/Android/Sdk && mv cmdline-tools/* cmdline-tools/latest/ 2>/dev/null || true
    cd ~/Android/Sdk && rm commandlinetools-linux-11076708_latest.zip
    @echo "📥 Installing SDK components..."
    cd ~/Android/Sdk/cmdline-tools/latest/bin && yes | ./sdkmanager "platform-tools" "platforms;android-34" "build-tools;34.0.0"
    @echo "sdk.dir=$$HOME/Android/Sdk" > local.properties
    @echo "✅ Android SDK installed and configured!"

# Setup Android SDK path (if you already have SDK installed elsewhere)
setup-sdk:
    @echo "Enter your Android SDK path (e.g., ~/Android/Sdk or /usr/lib/android-sdk):"
    @read -p "SDK path: " SDK_PATH && echo "sdk.dir=$$SDK_PATH" > local.properties
    @echo "✅ Created local.properties with SDK path"

# Build debug APK
build:
    ./gradlew assembleDebug

# Build release APK
build-release:
    ./gradlew assembleRelease

# Clean build
clean:
    ./gradlew clean

# Install debug APK to connected device
install:
    ./gradlew installDebug

# Build and install debug
dev: build install

# Run lint checks
lint:
    ./gradlew lint

# Run tests
test:
    ./gradlew test

# Generate signing key for release
generate-key:
    keytool -genkey -v -keystore dragon-nuke.keystore -alias dragon-nuke -keyalg RSA -keysize 2048 -validity 10000

# Build signed release APK (requires keystore)
build-signed:
    ./gradlew assembleRelease

# Show APK location after build
show-apk:
    @echo "Debug APK: app/build/outputs/apk/debug/app-debug.apk"
    @echo "Release APK: app/build/outputs/apk/release/app-release.apk"

# Copy file to running AVD (e.g., just copy-to-device ../gcp-key.json /sdcard/)
copy-to-device FILE DEST:
    adb push {{FILE}} {{DEST}}

# Serve debug APK via HTTP server on port 8000
serve-apk:
    cd app/build/outputs/apk/debug && python3 -m http.server