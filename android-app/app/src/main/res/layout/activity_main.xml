<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐉 Dragon Nuke"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:textColor="@android:color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Server Nuke Trigger"
            android:textSize="16sp"
            android:layout_marginBottom="40dp"
            android:textColor="@android:color/darker_gray" />

        <!-- Service Account Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Service Account Key"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:textColor="@android:color/black" />

        <Button
            android:id="@+id/btnLoadKey"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📁 Load Service Account Key"
            android:layout_marginBottom="12dp"
            style="@style/Widget.Material3.Button" />

        <TextView
            android:id="@+id/tvKeyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No service account key loaded"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:textColor="@android:color/darker_gray"
            android:fontFamily="monospace" />

        <!-- Bucket Configuration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bucket Configuration"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:textColor="@android:color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="dragon-nuke-bucket"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:background="@drawable/bucket_background"
            android:fontFamily="monospace" />

        <!-- GCP Connection Status -->
        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking connection..."
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:padding="8dp"
            android:textColor="@android:color/darker_gray"
            android:fontFamily="sans-serif-medium" />

        <!-- Current Trigger Value Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Trigger Value"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/tvCurrentValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:padding="12dp"
            android:background="@drawable/bucket_background"
            android:fontFamily="monospace"
            android:textColor="@android:color/black" />

        <Button
            android:id="@+id/btnRefreshValue"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="🔄 Refresh"
            android:textSize="14sp"
            android:layout_marginBottom="32dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <!-- Host Heartbeat Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Host Heartbeats"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/tvHeartbeatStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="14sp"
            android:gravity="start"
            android:layout_marginBottom="8dp"
            android:padding="12dp"
            android:background="@drawable/bucket_background"
            android:fontFamily="monospace"
            android:textColor="@android:color/black" />

        <Button
            android:id="@+id/btnRefreshHeartbeat"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="🔄 Refresh Heartbeats"
            android:textSize="14sp"
            android:layout_marginBottom="32dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <!-- Stale Heartbeat Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stale Heartbeats (>1 hour)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/tvStaleHeartbeats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="14sp"
            android:gravity="start"
            android:layout_marginBottom="32dp"
            android:padding="12dp"
            android:background="@drawable/bucket_background"
            android:fontFamily="monospace"
            android:textColor="@android:color/darker_gray" />

        <!-- Trigger Button -->
        <Button
            android:id="@+id/btnTriggerNuke"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="🔥 TRIGGER NUKE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textColor="@android:color/white"
            android:enabled="false" />

        <!-- Last Trigger Info -->
        <TextView
            android:id="@+id/tvLastTrigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:textColor="@android:color/darker_gray"
            android:fontStyle="italic" />

        <!-- Warning -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/warning_background"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ WARNING"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:textColor="@android:color/black" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This will nuke all block devices on ALL servers monitoring the bucket"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="@android:color/black" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>